# Environment variables override .odoo-mcp.toml. Paths are relative to the
# directory containing that file, or to the workspace when it is absent.
ODOO_MCP_PYTHON=.venv/bin/python
ODOO_MCP_EXECUTABLE=odoo/odoo-bin
ODOO_MCP_CONFIG=config/odoo.conf
ODOO_MCP_DATABASE=project_a_dev
# Optional OS-path-separated list of directories (':' on macOS/Linux).
# ODOO_MCP_ADDONS_PATH=odoo/addons:custom-addons
